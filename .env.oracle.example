# Copy this file to .env.oracle (gitignored) and fill in real values.
# Gather these with the `oci` CLI commands in the setup instructions.

COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxx
SUBNET_ID=ocid1.subnet.oc1..xxxxx
IMAGE_ID=ocid1.image.oc1..xxxxx
SSH_PUBLIC_KEY_FILE=$HOME/.ssh/do-snack-box.key.pub
INSTANCE_DISPLAY_NAME=snack-rating-box

# Space-separated list, e.g. "AD-1 AD-2 AD-3" (from availability-domain list)
AVAILABILITY_DOMAINS="AD-1 AD-2 AD-3"
