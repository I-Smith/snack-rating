<div id="<%= dom_id snack %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Brand:</strong>
    <%= snack.brand %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= snack.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Isaac rating:</strong>
    <%= snack.isaac_rating %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Kristina rating:</strong>
    <%= snack.kristina_rating %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= snack.notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tried on:</strong>
    <%= snack.tried_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Country of origin:</strong>
    <%= snack.country_of_origin %>
  </div>
</div>
