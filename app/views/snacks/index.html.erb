<% content_for :title, "Snack Vault" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-text-base">Snack Vault</h1>
    <%= link_to "New snack", new_snack_path, class: "rounded-md px-4 py-2 bg-primary text-white font-medium hover:opacity-90" %>
  </div>

  <div class="space-y-3">
    <% if @snacks.any? %>
      <% @snacks.each do |snack| %>
        <%= link_to snack, class: "block bg-surface rounded-xl border border-border p-4 hover:shadow-sm transition-shadow" do %>
          <div class="flex justify-between items-start">
            <div>
              <p class="font-semibold text-text-base"><%= snack.name %></p>
              <p class="text-sm text-text-muted"><%= snack.brand %> · <%= snack.country_of_origin %></p>
            </div>
            <div class="text-right text-sm">
              <p class="text-text-muted">Isaac <span class="font-semibold text-text-base"><%= snack.isaac_rating %></span></p>
              <p class="text-text-muted">Kristina <span class="font-semibold text-text-base"><%= snack.kristina_rating %></span></p>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-center text-text-muted py-10">No snacks yet — add your first one!</p>
    <% end %>
  </div>
</div>
