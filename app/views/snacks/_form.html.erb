<%= form_with(model: snack, class: "contents") do |form| %>
  <% if snack.errors.any? %>
    <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mb-4">
      <h2><%= pluralize(snack.errors.count, "error") %> prohibited this snack from being saved:</h2>
      <ul class="list-disc ml-6 mt-1">
        <% snack.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= form.label :brand, class: "block text-sm font-medium text-text-base mb-1" %>
      <%= form.text_field :brand, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-text-base mb-1" %>
      <%= form.text_field :name, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <div>
      <%= form.label :country_of_origin, class: "block text-sm font-medium text-text-base mb-1" %>
      <%= form.text_field :country_of_origin, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <div>
      <%= form.label :tried_on, class: "block text-sm font-medium text-text-base mb-1" %>
      <%= form.date_field :tried_on, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <div class="flex gap-4">
      <div class="flex-1">
        <%= form.label :isaac_rating, "Isaac", class: "block text-sm font-medium text-text-base mb-1" %>
        <%= form.number_field :isaac_rating, min: 0, max: 10, step: 0.1, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
      </div>
      <div class="flex-1">
        <%= form.label :kristina_rating, "Kristina", class: "block text-sm font-medium text-text-base mb-1" %>
        <%= form.number_field :kristina_rating, min: 0, max: 10, step: 0.1, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
      </div>
    </div>

    <div>
      <%= form.label :notes, class: "block text-sm font-medium text-text-base mb-1" %>
      <%= form.text_area :notes, rows: 4, class: "block w-full rounded-md border border-border px-3 py-2 text-text-base focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <%= form.submit class: "w-full rounded-md px-4 py-3 bg-primary text-white font-medium cursor-pointer hover:opacity-90" %>
  </div>
<% end %>
