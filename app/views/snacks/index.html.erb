<% content_for :title, "Snack Vault" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <%= link_to "New snack", new_snack_path, class: "ml-auto rounded-md px-4 py-2 bg-primary text-white font-medium hover:opacity-90" %>
  </div>

  <div data-controller="search">
    <%= form_with url: snacks_path, method: :get,
          data: { turbo_frame: "snacks", search_target: "form" } do |form| %>
      <%= form.search_field :query, value: params[:query],
            placeholder: "Search by name, brand, or country...",
            data: { action: "input->search#search" },
            class: "block w-full rounded-md border-2 border-border bg-surface shadow-sm px-3 py-3 text-text-base focus:outline-none focus:ring-2 focus:ring-primary mb-4" %>
    <% end %>
  </div>

  <%= turbo_frame_tag "snacks" do %>
    <div class="space-y-3">
      <% if @snacks.any? %>
        <% @snacks.each do |snack| %>
          <%= link_to snack, data: { turbo_frame: "_top" }, class: "block bg-surface rounded-xl border border-border border-l-4 border-l-primary shadow-sm p-4 hover:shadow-md transition-shadow" do %>
            <div class="flex justify-between items-start">
              <div>
                <p class="font-semibold text-text-base"><%= snack.name %></p>
                <p class="text-sm text-text-muted"><%= snack.brand %> · <%= snack.country_of_origin %></p>
              </div>
              <div class="text-right text-sm space-y-1">
                <p class="bg-surface-subtle rounded px-2 py-0.5 text-text-muted">Isaac <span class="font-semibold text-primary"><%= snack.isaac_rating %></span></p>
                <p class="bg-surface-subtle rounded px-2 py-0.5 text-text-muted">Kristina <span class="font-semibold text-primary"><%= snack.kristina_rating %></span></p>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-center text-text-muted py-10">No snacks found.</p>
      <% end %>
    </div>
  <% end %>
</div>
