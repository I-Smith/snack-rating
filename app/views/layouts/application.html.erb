<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Snack Rating" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Snack Rating">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      const t = localStorage.getItem("theme") || "teal";
      document.documentElement.classList.add("theme-" + t);
    </script>
  </head>

  <body class="bg-background min-h-screen">
    <header class="bg-primary sticky top-0 z-10">
      <div class="container mx-auto px-4 py-3 flex justify-between items-center" data-controller="theme">
        <%= link_to "🍿 Snack Vault", root_path, class: "text-xl font-bold text-white" %>
        <%# Theme picker — uncomment to re-enable
        <select data-action="change->theme#switchFromSelect"
                data-theme-target="select"
                class="text-sm rounded-md px-2 py-1 bg-white/20 text-white border border-white/30 cursor-pointer">
          <option value="amber">🟠 Amber</option>
          <option value="blue">🔵 Blue</option>
          <option value="teal">🩵 Teal</option>
          <option value="green">🟢 Green</option>
          <option value="rose">🌸 Rose</option>
          <option value="purple">🟣 Purple</option>
          <option value="slate">🩶 Slate</option>
        </select>
        %>
      </div>
    </header>

    <main class="container mx-auto px-4 py-6 max-w-2xl">
      <%= yield %>
    </main>
  </body>
</html>
